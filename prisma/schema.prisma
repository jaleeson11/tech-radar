// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// User model - represents authenticated users (NextAuth compatible)
model User {
  id                String    @id @default(cuid())
  name              String?
  email             String?   @unique
  emailVerified     DateTime?
  image             String?
  hasSeenOnboarding Boolean   @default(false) // Track if user has seen onboarding modal
  createdAt         DateTime  @default(now())

  // NextAuth relations
  accounts      Account[]
  sessions      Session[]

  // App-specific relations
  radars        Radar[]        // One user has many radars
  radarAccesses RadarAccess[]  // Track radars accessed via share link

  @@map("users")
}

// Account model - for OAuth providers (NextAuth)
model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@map("accounts")
}

// Session model - for database sessions (NextAuth)
model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("sessions")
}

// VerificationToken model - for email magic links (NextAuth)
model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
  @@map("verification_tokens")
}

// Radar model - represents a technology radar
model Radar {
  id         String     @id @default(cuid())
  name       String
  ownerId    String
  owner      User       @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  shareToken String     @unique @default(cuid()) // Single share link - anyone with link can edit
  quadrants  Json          // Array of 4 quadrant names
  rings      Json          // Array of 4 ring names
  createdAt  DateTime      @default(now())
  updatedAt  DateTime      @updatedAt // Manually update when items change to track last edit
  items      TechItem[]    // One radar has many tech items
  accesses   RadarAccess[] // Track which users have accessed this radar

  @@index([shareToken])
  @@index([ownerId])
  @@index([updatedAt])
  @@map("radars")
}

// RadarAccess model - tracks when authenticated users access shared radars
model RadarAccess {
  id         String   @id @default(cuid())
  radarId    String
  userId     String
  radar      Radar    @relation(fields: [radarId], references: [id], onDelete: Cascade)
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  lastViewed DateTime @default(now())
  createdAt  DateTime @default(now())

  @@unique([radarId, userId])
  @@index([userId])
  @@index([radarId])
  @@map("radar_accesses")
}

// TechItem model - represents a technology item on a radar
model TechItem {
  id          String   @id @default(cuid())
  radarId     String
  radar       Radar    @relation(fields: [radarId], references: [id], onDelete: Cascade)
  name        String
  quadrant    Int      // 0-3 index for quadrant position
  ring        Int      // 0-3 index for ring position
  positionX   Float?   // Optional saved x coordinate
  positionY   Float?   // Optional saved y coordinate
  description String?  // Optional description
  url         String?  // Optional URL
  category    String?  // Optional category for organization
  icon        String?  // Optional simple-icons slug for displaying icon
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([radarId])
  @@map("tech_items")
}
